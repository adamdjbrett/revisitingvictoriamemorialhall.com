{
  "name": "revisitingvictoriamemorialhall.com",
  "version": "1.0.0",
  "private": true,
  "description": "Coming-soon website for Revisiting Victoria Memorial Hall.",
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('_site', { recursive: true, force: true })\"",
