    "start": "npm run dev",
    "test": "npm run build && python3 scripts/check_build.py"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "js-yaml": "4.3.2"
  }
}
