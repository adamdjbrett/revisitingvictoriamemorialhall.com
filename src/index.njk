---
date: 2026-10-29
tags: pages
permalink: /index.html
buildawesomeComputed:
  title: "{{ site.title }} — {{ site.home.titleSuffix }}"
---
<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="generator" content="{{ generator | escape }}">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ site.themeColor | escape }}">
  <meta name="description" content="{{ site.description | escape }}">
  <title>{{ title | escape }}</title>
  <meta property="og:title" content="{{ site.title | escape }}">
  <meta property="og:url" content="{{ site.url }}/">
  <meta property="og:description" content="{{ site.openGraphDescription | escape }}">
  <meta property="og:type" content="website">
  <link rel="canonical" href="{{ site.url }}/">
  <link rel="author" href="/humans.txt">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title | escape }}" href="{{ site.url }}/feed/feed.xml">
  <link rel="alternate" type="application/feed+json" title="{{ site.title | escape }}" href="{{ site.url }}/feed/feed.json">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="{{ assetPrefix }}/icons/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ assetPrefix }}/icons/icon-192.png">
  <style>{{ criticalCss | safe }}</style>
  <script src="{{ assetPrefix }}/pwa.js" defer></script>
</head>
<body>
  <div class="cl-soon01">
    <picture>
      <source media="(max-width: 560px)" srcset="{{ assetPrefix }}/images/{{ site.background.mobile.file | escape }}">
      <img class="cl-soon01__bg" src="{{ assetPrefix }}/images/{{ site.background.desktop.file | escape }}" width="{{ site.background.desktop.width }}" height="{{ site.background.desktop.height }}" fetchpriority="high" alt="{{ site.background.alt | escape }}">
    </picture>
    <header class="cl-soon01__bar">
      <a class="cl-soon01__logo" href="/">{{ site.home.wordmark | escape }}</a>
      <a class="cl-soon01__contact" href="{{ site.resources.symposium.url | escape }}">{{ site.home.aboutLabel | escape }}</a>
    </header>

    <main class="cl-soon01__main" id="main">
      <p class="cl-soon01__eyebrow">{{ site.home.status | escape }}</p>
      <h1 class="cl-soon01__title">{{ site.title | escape }}</h1>
      <p class="cl-soon01__text">{{ site.home.tagline | escape }}</p>

      <nav class="cl-soon01__count" aria-label="{{ site.home.researchLabel | escape }}">
        <a class="cl-soon01__unit" href="{{ site.resources.symposium.url | escape }}"><span class="cl-soon01__lbl">{{ site.resources.symposium.label | escape }}</span></a>
        {% for person in site.team %}
        <a class="cl-soon01__unit" href="{{ person.url | escape }}"><span class="cl-soon01__lbl">{{ site.home.personLinkPrefix | escape }} {{ person.name | escape }}</span></a>
        {% endfor %}
        <a class="cl-soon01__unit" href="{{ site.resources.research.url | escape }}"><span class="cl-soon01__lbl">{{ site.resources.research.label | escape }}</span></a>
      </nav>

      <p class="cl-soon01__note">{% for line in site.home.notice %}{{ line | escape }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
    </main>

    <footer class="cl-soon01__foot">
      <p class="cl-soon01__copy">{{ site.home.footer | escape }}</p>
      <div class="project-credit">
        <p><a href="{{ site.background.credit.url | escape }}">{{ site.background.credit.photographer | escape }}</a>, <a href="{{ site.background.credit.licenseUrl | escape }}">{{ site.background.credit.license | escape }}</a>, {{ site.background.credit.source | escape }}</p>
      </div>
    </footer>
  </div>
</body>
</html>
